{
	"name": "ai-image-analyzer",
	"version": "1.4.1",
	"description": "This plugin analyzes images with AI to get keywords of the image.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "",
	"license": "GPL-3.0",
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@types/node": "26.6.6",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"eslint-plugin-prettier": "5.5.7",
		"obsidian": "1.14.4",
		"prettier": "3.9.10",
		"tslib": "2.9.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@google/genai": "^2.32.0",
		"@obsidian-ai-providers/sdk": "^1.9.0",
		"ollama": "^0.6.4",
		"p-queue": "^10.0.0"
	}
